# ShadeShift configuration (CONTRACT.md §9). Copy to .env and uncomment what you need.
# Command-line flags of run.py override environment variables, which override this file.

# Bind address. Keep 127.0.0.1; use 0.0.0.0 only together with SHADESHIFT_API_TOKEN.
# SHADESHIFT_HOST=127.0.0.1
# SHADESHIFT_API_PORT=8000
# SHADESHIFT_DASHBOARD_PORT=8501
# SHADESHIFT_API_URL=http://127.0.0.1:8000

# If set, write requests must send header X-ShadeShift-Token with this value. Reads never need it.
# SHADESHIFT_API_TOKEN=

# Runtime data (database, gateway outbox, caches, exports). Relative paths are from the project root.
# SHADESHIFT_DATA_DIR=data
# SHADESHIFT_DB_PATH=data/shadeshift.db

# Research tree with the selector weights, digital twin and lab curves (read-only).
# SHADESHIFT_ML_DIR=SHADESHIFT_ML
# SHADESHIFT_LAB_DIR=SHADESHIFT_ML/data/data_lab

# Edge AI: ONNX model file and runtime (auto | onnx | numpy).
# SHADESHIFT_MODEL_PATH=models/pemilih.onnx
# SHADESHIFT_EDGE_RUNTIME=auto

# Gateway: data source (serial | demo), serial port (auto = detect the ESP32 by USB id), baud, device id.
# SHADESHIFT_SOURCE=demo
# SHADESHIFT_SERIAL_PORT=auto
# SHADESHIFT_SERIAL_BAUD=115200
# SHADESHIFT_DEVICE_ID=esp32-01

# Demo mode: scenario name in scenarios/ and time multiplier.
# SHADESHIFT_DEMO_SCENARIO=default
# SHADESHIFT_DEMO_SPEED=1.0

# A device counts as online if its last heartbeat is newer than this many seconds.
# SHADESHIFT_ONLINE_TIMEOUT_S=10
# SHADESHIFT_LOG_LEVEL=INFO

# Optional (CONTRACT section 27): Gemini (Google, free tier) rewrites the sentences of the analyser box on Kurva I-V and
# Riwayat in simpler words. Every number and verdict still comes from the light model on this laptop; an answer with any
# number not in the facts is thrown away. Needs internet; without a key, without internet or on any error the page uses
# the local sentences. Free-tier content may be used by Google to improve its products: only the analysis sentences are
# sent (no device id, no names). Get a key yourself at Google AI Studio and paste it here; never share it.
# SHADESHIFT_GEMINI_API_KEY=
# SHADESHIFT_GEMINI_MODEL=gemini-flash-latest
